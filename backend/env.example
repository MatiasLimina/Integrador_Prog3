# Copiar a .env y completar con valores locales. NO commitear .env.
POSTGRES_USER=usuario
POSTGRES_PASSWORD=clave
POSTGRES_DB=libreria
DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/libreria
# En Easypanel (Environment del servicio backend) tiene esta forma; usar el host INTERNO del
# servicio Postgres (<proyecto>_<servicio>), nunca una IP ni un dominio publico, y el driver
# postgresql+asyncpg. Tomar la "Internal Connection URL" del servicio y cambiar solo el esquema:
# DATABASE_URL=postgresql+asyncpg://<usuario>:<clave>@<proyecto>_<servicio-postgres>:5432/<base>
# true muestra en consola las consultas SQL emitidas
DB_ECHO=false
# Opcional: puerto del host para PostgreSQL si el 5432 esta ocupado (ajustar tambien DATABASE_URL)
# POSTGRES_PORT=5432
# Tests: 1 hace que la falta de base libreria_test sea un fallo y no un skip
# REQUIRE_TEST_DB=1
